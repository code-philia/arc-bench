{
  "name": "arc-reproduction",
  "version": "0.1.0",
  "private": true,
  "description": "Reproduction package for ARC web application generation and evaluation.",
  "scripts": {
    "docker:build": "docker build --progress=plain -t arc-reproduction:latest .",
    "reference": "node scripts/run-reference-docker.js",
    "reference:12306": "node scripts/run-reference-docker.js --app 12306",
    "reference:all": "node scripts/run-reference-docker.js --app all",
    "test": "node scripts/run-playwright.js",
    "test:docker": "node scripts/run-test-docker.js",
    "test:app": "node scripts/run-playwright.js --app",
    "test:all": "node scripts/run-playwright.js --app all",
    "test:install": "playwright install"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
